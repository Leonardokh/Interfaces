<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="ProtoBuilderPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Registro de Entidades -->
        <class>es.protobuilder.model.Usuario</class>
        <class>es.protobuilder.model.PerfilJugador</class>
        <class>es.protobuilder.model.PersonajeBuild</class>
        <class>es.protobuilder.model.EquipamientoPrincipal</class>
        <class>es.protobuilder.model.PiezaEquipamiento</class>
        <class>es.protobuilder.model.SubstatPieza</class>
        <class>es.protobuilder.model.EstadisticaPersonaje</class>

        <properties>
            <!-- Conexión JDBC a MySQL local -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/protobuilder_db?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true" />
            <property name="jakarta.persistence.jdbc.user" value="Ryuno" />
            <property name="jakarta.persistence.jdbc.password" value="Ryuno1." />

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.hbm2ddl.create_namespaces" value="true" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>

    </persistence-unit>
</persistence>