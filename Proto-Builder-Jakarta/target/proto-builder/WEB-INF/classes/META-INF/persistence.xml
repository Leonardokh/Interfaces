<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="ProtoBuilderPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Registro de Entidades -->
        <class>es.protobuilder.model.Usuario</class>
        <class>es.protobuilder.model.PerfilJugador</class>
        <class>es.protobuilder.model.PersonajeBuild</class>
        <class>es.protobuilder.model.EquipamientoPrincipal</class>
        <class>es.protobuilder.model.PiezaEquipamiento</class>
        <class>es.protobuilder.model.SubstatPieza</class>
        <class>es.protobuilder.model.EstadisticaPersonaje</class>


        <properties>
            <!-- Conexión JDBC a la base de datos en la nube (Aiven) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://protobuild-protobuild.l.aivencloud.com:28083/ProtoBuild?useSSL=true&amp;requireSSL=true&amp;verifyServerCertificate=false&amp;serverTimezone=UTC" />
            <property name="jakarta.persistence.jdbc.user" value="avnadmin" />
            <property name="jakarta.persistence.jdbc.password" value="AVNS_M-9RpwUScLen-AO--jI" />

            <!-- Dialecto de Hibernate para MySQL 8 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />

            <!-- Generación automática de tablas (usa 'create' una vez para generar el esquema y luego vuelve a 'update') -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- Visualización de consultas SQL en consola -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>

